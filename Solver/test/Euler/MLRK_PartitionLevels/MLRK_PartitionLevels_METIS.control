!
!  MLRK level-aware MPI partition (issue 402), METIS partitioner. Run with 4 MPI ranks.
!  N=6 in the column x < 2*pi/8 makes it level 2; its neighbour columns are level 1 but needed at
!  level 2 (MLevelwN = 2). Partition counts by MLevelwN: 320 elements in level 1, 192 in level 2.
!  With "optimized partition" every rank should own about 1/4 of each (checked in UserDefinedFinalize).
!
Flow equations           = "Euler"
mesh file name           = "../../TestMeshes/TaylorGreen8.mesh"
polynomial order file    = "orders.dat"
discretization nodes     = Gauss-Lobatto
riemann solver           = roe
mach number              = 0.08
AOA theta                = 0.0
AOA phi                  = 0.0
restart                  = .false.
restart file name        = "RESULTS/MLRK_PartitionLevels_METIS.hsol"
solution file name       = "RESULTS/MLRK_PartitionLevels_METIS.hsol"
simulation type          = time-accurate
explicit method          = multi level rk3
optimized partition      = .true.
! partitioning: METIS (default)
partitioning with weights = .false.
number of level          = 2
cfl cut-off              = 0.4
dt                       = 2.0e-3
number of time steps     = 1
output interval          = 1
number of plot points    = 2
convergence tolerance    = 1.d-14

#define boundary front
  type = periodic
  coupled boundary = back
#end

#define boundary back
  type = periodic
  coupled boundary = front
#end

#define boundary bottom
  type = periodic
  coupled boundary = top
#end

#define boundary top
  type = periodic
  coupled boundary = bottom
#end

#define boundary left
  type = periodic
  coupled boundary = right
#end

#define boundary right
  type = periodic
  coupled boundary = left
#end
