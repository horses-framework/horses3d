         END SUBROUTINE UserDefinedPeriodicOperation
!
!////////////////////////////////////////////////////////////////////////
!
#ifdef FLOW
         subroutine UserDefinedSourceTermNS(x, Q, time, S, thermodynamics_, dimensionless_, refValues_ &
#ifdef CAHNHILLIARD
, multiphase_ &
#endif
#ifdef ACOUSTIC
, Qbase, Lambbase, Lamb &
#endif
)
            use SMConstants
            USE HexMeshClass
            use PhysicsStorage
            use FluidData
            IMPLICIT NONE
            real(kind=RP),          intent(in)    :: x(NDIM)
            real(kind=RP),          intent(in)    :: Q(NCONS)
            real(kind=RP),          intent(in)    :: time
            real(kind=RP),          intent(inout) :: S(NCONS)
            type(Thermodynamics_t), intent(in)    :: thermodynamics_
            type(Dimensionless_t),  intent(in)    :: dimensionless_
            type(RefValues_t),      intent(in)    :: refValues_
#ifdef CAHNHILLIARD
            type(Multiphase_t),     intent(in)    :: multiphase_
#endif
#ifdef ACOUSTIC
            real(kind=RP),          intent(in)    :: Qbase(NCONSB)
            real(kind=RP),          intent(in)    :: Lambbase(NDIM)
            real(kind=RP),          intent(in)    :: Lamb(NDIM)
#endif
#ifdef @MACRO@
            call MMS_Source(x, time, thermodynamics_, dimensionless_, refValues_, &
#ifdef CAHNHILLIARD
                            multiphase_, &
#endif
#ifdef ACOUSTIC
                            Qbase, &
#endif
                            S)
#endif
         end subroutine UserDefinedSourceTermNS
#endif
!
!////////////////////////////////////////////////////////////////////////
!
         SUBROUTINE UserDefinedFinalize(mesh, time, iter, maxResidual &
#ifdef FLOW
                                                    , thermodynamics_ &
                                                    , dimensionless_  &
                                                    , refValues_ &
#endif
#ifdef CAHNHILLIARD
                                                    , multiphase_ &
#endif
                                                    , monitors, &
                                                      elapsedTime, &
                                                      CPUTime   )
            use SMConstants
            USE HexMeshClass
            use PhysicsStorage
            use FluidData
            use MonitorsClass
            use NodalStorageClass, only: GAUSS
            use GaussQuadrature,   only: GaussLegendreNodesAndWeights, LegendreLobattoNodesAndWeights
            IMPLICIT NONE
            CLASS(HexMesh)                        :: mesh
            REAL(KIND=RP)                         :: time
            integer                               :: iter
            real(kind=RP)                         :: maxResidual
#ifdef FLOW
            type(Thermodynamics_t), intent(in)    :: thermodynamics_
            type(Dimensionless_t),  intent(in)    :: dimensionless_
            type(RefValues_t),      intent(in)    :: refValues_
#endif
#ifdef CAHNHILLIARD
            type(Multiphase_t),     intent(in)    :: multiphase_
#endif
            type(Monitor_t),        intent(in)    :: monitors
            real(kind=RP),          intent(in)    :: elapsedTime
            real(kind=RP),          intent(in)    :: CPUTime
#ifdef @MACRO@
            integer       :: eID, i, j, k, fid, NDOF
            real(kind=RP) :: Qex(NCONS), wq, vol, sq(NCONS)
            real(kind=RP) :: xi(0:24), w(0:24,3)
!
!           Volume integral of the squared error per variable, with the
!           quadrature of the discretization nodes. Rank-local: sequential only.
!
            vol  = 0.0_RP
            sq   = 0.0_RP
            NDOF = 0
            do eID = 1, size(mesh % elements)
               associate( e => mesh % elements(eID) )
               if ( minval(e % Nxyz) < 1 .or. maxval(e % Nxyz) > 24 ) error stop "MMS: polynomial order must be 1 to 24"
               NDOF = NDOF + product(e % Nxyz + 1)
               do i = 1, 3
                  if ( mesh % nodeType == GAUSS ) then
                     call GaussLegendreNodesAndWeights(e % Nxyz(i), xi(0:e % Nxyz(i)), w(0:e % Nxyz(i),i))
                  else
                     call LegendreLobattoNodesAndWeights(e % Nxyz(i), xi(0:e % Nxyz(i)), w(0:e % Nxyz(i),i))
                  end if
               end do
               do k = 0, e % Nxyz(3) ; do j = 0, e % Nxyz(2) ; do i = 0, e % Nxyz(1)
                  call MMS_State(e % geom % x(:,i,j,k), time, thermodynamics_, dimensionless_, refValues_, &
#ifdef CAHNHILLIARD
                                 multiphase_, &
#endif
                                 Qex)
                  wq  = w(i,1) * w(j,2) * w(k,3) * e % geom % jacobian(i,j,k)
                  vol = vol + wq
                  sq  = sq + wq * (Qex - e % storage % Q(:,i,j,k))**2
               end do ; end do ; end do
               end associate
            end do

            print *, "MMS volume         : ", vol
            print *, "MMS L2 error total : ", sqrt(sum(sq) / vol)
            print *, "MMS L2 error vars  : ", sqrt(sq / vol)

            open(newunit=fid, file="mms_l2_error.dat", status="replace")
            write(fid, '(I10, A, I5, A, I12, *(A, ES24.16E3))') &
               size(mesh % elements), ', ', mesh % elements(1) % Nxyz(1), ', ', NDOF, &
               ', ', vol, ', ', sqrt(sum(sq) / vol), (', ', sqrt(sq(i) / vol), i = 1, NCONS), ', ', time
            close(fid)
#endif
         END SUBROUTINE UserDefinedFinalize
!
!////////////////////////////////////////////////////////////////////////
!
      SUBROUTINE UserDefinedTermination
         IMPLICIT NONE
      END SUBROUTINE UserDefinedTermination
!
!////////////////////////////////////////////////////////////////////////
!
#ifdef @MACRO@
      subroutine MMS_State(x, t, thermodynamics_, dimensionless_, refValues_, &
#ifdef CAHNHILLIARD
                           multiphase_, &
#endif
                           Q)
!
!        Manufactured state at (x, t)
!
         use SMConstants
         use PhysicsStorage
         use FluidData
         implicit none
         real(kind=RP),          intent(in)  :: x(NDIM)
         real(kind=RP),          intent(in)  :: t
         type(Thermodynamics_t), intent(in)  :: thermodynamics_
         type(Dimensionless_t),  intent(in)  :: dimensionless_
         type(RefValues_t),      intent(in)  :: refValues_
#ifdef CAHNHILLIARD
         type(Multiphase_t),     intent(in)  :: multiphase_
#endif
         real(kind=RP),          intent(out) :: Q(NCONS)
@STATE@
      end subroutine MMS_State
!
!////////////////////////////////////////////////////////////////////////
!
      subroutine MMS_Source(x, t, thermodynamics_, dimensionless_, refValues_, &
#ifdef CAHNHILLIARD
                            multiphase_, &
#endif
#ifdef ACOUSTIC
                            Qbase, &
#endif
                            S)
!
!        Residual of the manufactured state at (x, t), the source term
!
         use SMConstants
         use PhysicsStorage
         use FluidData
         implicit none
         real(kind=RP),          intent(in)  :: x(NDIM)
         real(kind=RP),          intent(in)  :: t
         type(Thermodynamics_t), intent(in)  :: thermodynamics_
         type(Dimensionless_t),  intent(in)  :: dimensionless_
         type(RefValues_t),      intent(in)  :: refValues_
#ifdef CAHNHILLIARD
         type(Multiphase_t),     intent(in)  :: multiphase_
#endif
#ifdef ACOUSTIC
         real(kind=RP),          intent(in)  :: Qbase(NCONSB)
#endif
         real(kind=RP),          intent(out) :: S(NCONS)
@SOURCE@
      end subroutine MMS_Source
#endif
