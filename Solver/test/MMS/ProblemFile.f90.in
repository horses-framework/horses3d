!
         SUBROUTINE UserDefinedPeriodicOperation(mesh, time, dt, Monitors &
#ifdef FLOW
                                                 , thermodynamics_ &
                                                 , dimensionless_  &
                                                 , refValues_ &
#endif
#ifdef CAHNHILLIARD
                                                 , multiphase_ &
#endif
                                                 )
            use SMConstants
            USE HexMeshClass
            use MonitorsClass
            use fluiddata
            use physicsstorage
            IMPLICIT NONE
            CLASS(HexMesh)               :: mesh
            REAL(KIND=RP)                :: time
            REAL(KIND=RP)                :: dt
            type(Monitor_t), intent(in)  :: monitors
#ifdef FLOW
            type(Thermodynamics_t), intent(in)    :: thermodynamics_
            type(Dimensionless_t),  intent(in)    :: dimensionless_
            type(RefValues_t),      intent(in)    :: refValues_
#endif
#ifdef CAHNHILLIARD
            type(Multiphase_t),     intent(in)    :: multiphase_
