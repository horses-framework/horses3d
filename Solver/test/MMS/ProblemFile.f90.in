!
!////////////////////////////////////////////////////////////////////////
!
!      ProblemFile for the HORSES3D MMS convergence tests (@SOLVER@).
!      Generated by Solver/test/MMS/generate.py from ProblemFile.f90.in:
!      edit those, not this file.
!
!      The manufactured state is the initial condition, its residual is
!      added as a source term, and the L2 error at the final time is
!      written to mms_l2_error.dat:
!         nelems, P, NDOF, volume, L2_total, L2 of each variable, t_final
!      Errors are normalised by the mesh volume (integral of 1).
!
!////////////////////////////////////////////////////////////////////////
!
#include "Includes.h"
module ProblemFileFunctions
   implicit none

   abstract interface
      subroutine UserDefinedStartup_f
      end subroutine UserDefinedStartup_f

      SUBROUTINE UserDefinedFinalSetup_f(mesh &
#ifdef FLOW
                                     , thermodynamics_ &
                                     , dimensionless_  &
                                     , refValues_ &
#endif
#ifdef CAHNHILLIARD
                                     , multiphase_ &
#endif
                                     )
         USE HexMeshClass
         use FluidData
         IMPLICIT NONE
         CLASS(HexMesh)                      :: mesh
#ifdef FLOW
         type(Thermodynamics_t), intent(in)  :: thermodynamics_
         type(Dimensionless_t),  intent(in)  :: dimensionless_
         type(RefValues_t),      intent(in)  :: refValues_
#endif
#ifdef CAHNHILLIARD
         type(Multiphase_t),     intent(in)  :: multiphase_
#endif
      END SUBROUTINE UserDefinedFinalSetup_f

