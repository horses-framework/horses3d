Flow equations        = "NS"
mesh file name        = "../../TestMeshes/cube_50_50.msh"

restart file name     = "RESULTS/GaussianTransport2D.rst"
solution file name    = "RESULTS/GaussianTransport2D.rst"
restart               = .false.

!Discretization nodes = "Gauss"
Discretization nodes = "Gauss-Lobatto"

Polynomial order i    = 2
Polynomial order j    = 2
Polynomial order k    = 1

transport velocity type = "user-defined"
transport diffusion-dispersion coefficient type = "user-defined"

simulation type = "time-accurate"
explicit method = "rk3"
final time = 0.10000001
dt = 0.0001
Number of time steps  = 10000000

Output Interval       = 100
Number of plot points = 2
Convergence tolerance = 1.d-10

!cfl                   = 0.2
!dcfl                  = 0.2
mach number           = 0.08
Reynolds number       = 1600.0

riemann solver        = "central"

AOA theta             = 0.0
AOA phi               = 0.0

autosave mode = "time"
autosave interval = 0.01

#define boundary front
  type = periodic
  coupled boundary = back
#end

#define boundary bottom
   type = periodic
   coupled boundary = top
#end

#define boundary top
   type = periodic
   coupled boundary = bottom
#end

#define boundary back
   type = periodic
   coupled boundary = front
#end

#define boundary left
   type = periodic
   coupled boundary = right
#end

#define boundary right
   type = periodic
   coupled boundary = left
#end
